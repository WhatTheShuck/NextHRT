AUTH_SECRET="" # Added by `npx auth`. Read more: https://cli.authjs.dev
AUTH_MICROSOFT_ENTRA_ID_ID="the application ID for entra"
AUTH_MICROSOFT_ENTRA_ID_SECRET="the secret value from enterprise app"
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/your tenant ID/v2.0"
AUTH_TRUST_HOST=true
AUTH_URL="your fqdn"
# Base URL better-auth issues callbacks against, e.g. https://hrt.example.com/api/auth
BETTER_AUTH_URL=""
# Public FQDN used for links in outgoing email (no trailing slash), e.g.
# https://hrt.example.com. Must be set for containers — the app binds 0.0.0.0
# inside Docker, so links can never be derived from the request host.
# Falls back to BETTER_AUTH_URL (minus /api/auth), then AUTH_URL.
APP_URL=""
DATABASE_URL="file:./prisma/dev.db"
# File upload configuration
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp,application/pdf
MAX_FILE_SIZE=5242880
MAX_FILE_SIZE_DISPLAY=5MB
ALLOWED_TYPES_DISPLAY=JPEG, PNG, WebP, PDF
NEXT_PUBLIC_CONTACT_NAME="Your IT Contact Name"
NEXT_PUBLIC_CONTACT_PHONE="Your IT Contact Phone Number"
NEXT_PUBLIC_CONTACT_EMAIL="Your IT Contact Email Address"
NEXT_PUBLIC_CONTACT_ROLE="Your IT Contact Role"
NEXT_PUBLIC_COMPANY_NAME="Your Business name to be displayed"
NEXT_PUBLIC_COMPANY_DOMAIN_EXTENSION="Your domain extension"

# User-Employee matching settings (seeds the AppSetting table on first run)
# Enable matching by email local part (e.g. jane.smith@company.com)
USER_MATCH_EMAIL_ENABLED=true
# Template describing the email local-part structure; use {firstName} and {lastName}
USER_MATCH_EMAIL_TEMPLATE={firstName}.{lastName}
# Enable exact display-name matching
USER_MATCH_NAME_EXACT_ENABLED=true
# Enable fuzzy name matching via Levenshtein similarity
USER_MATCH_NAME_FUZZY_ENABLED=true
# Minimum Levenshtein similarity (0.0–1.0) to treat as a fuzzy match
USER_MATCH_NAME_FUZZY_THRESHOLD=0.7
# Minimum combined score (0–100) for a suggestion to appear in the UI
USER_MATCH_SUGGESTION_THRESHOLD=50

# --- Mail (nodemailer) ---
MAIL_HOST="smtp.example.com"
# 465 for implicit TLS (secure), 587 for STARTTLS
MAIL_PORT=465
# Local hostname sent in the SMTP HELO/EHLO (optional)
MAIL_NAME=""
MAIL_USER=""
MAIL_PASS=""
# Default From header for outgoing mail, e.g. "HRT" <HRT@ksb.com>
MAIL_FROM=""
# Reply-To address — set this to a real mailbox so recipients can reply (optional)
MAIL_REPLY_TO=""
# Set to "true" to accept self-signed / invalid TLS certificates
MAIL_ACCEPT_SELFSIGNED=false

# --- Onboarding config (§6.7) ---
# Base URL for IT service-offering tickets; a program's ticket number is appended.
ONBOARDING_IT_TICKET_BASE_URL="https://itsp.intern.ksb.com/assystnet/#serviceOfferings/"
# Base URL of the AssetCheckout platform (hardware requests + Snipe-IT user lifecycle).
ONBOARDING_HARDWARE_ENDPOINT="https://checkout.ksb.com.au/"
# Shared secret for AssetCheckout's /api/integrations/hrt/* routes. Must match
# HRT_API_KEY in the AssetCheckout backend's .env. Generate with: openssl rand -hex 32
ASSET_CHECKOUT_API_KEY=""
# Email recipients for onboarding job fan-out (editable later via App Settings → Onboarding).
ONBOARDING_RECIPIENT_MARKETING=""
ONBOARDING_RECIPIENT_MEDICAL=""
ONBOARDING_RECIPIENT_LICENCE=""

# --- Ticket expiry reminders ---
# Comma-separated day milestones before a ticket's expiry at which to send a
# renewal reminder (one email per milestone). The largest value also caps how far
# ahead expiries are considered — reminders never fire beyond this horizon.
TICKET_EXPIRY_REMINDER_DAYS="365,180,90,30"

# --- IT induction questionnaire ---
# Recipient for the per-person IT-induction quiz summary (editable later via App
# Settings). Falls back to all Admin users when left blank.
IT_QUIZ_SUMMARY_EMAIL=""

# --- Calendar zone ---
# The zone date-only values (start dates, expiry dates) were entered in, and so
# the zone they must be read back in. Server-side renders — calendar invites,
# email date tokens, PDFs — are pinned to this rather than the container's
# ambient TZ. Defaults to Australia/Brisbane when unset.
APP_TIME_ZONE="Australia/Brisbane"
